<!DOCTYPE html>
<html lang="bn" class="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mihadx Pro BD Shop</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Hind Siliguri', sans-serif; }
    .dark body { background-color: #1a202c; color: white; }
    .hidden-section { display: none; }
  </style>
</head>
<body class="bg-slate-50 transition-colors duration-300">

  <!-- Auth Overlay -->
  <div id="auth-screen" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/95 text-white p-4">
    <div class="text-center">
      <h1 class="text-3xl font-bold mb-4">স্বাগতম!</h1>
      <button id="btn-login" class="bg-orange-600 px-8 py-3 rounded-full font-bold shadow-lg hover:bg-orange-700">Google লগইন করুন</button>
    </div>
  </div>

  <!-- App Content -->
  <div id="app-content" class="hidden">
    <!-- Header -->
    <header class="sticky top-0 bg-white dark:bg-slate-800 shadow p-4 flex justify-between items-center z-40">
      <h1 class="text-xl font-bold text-orange-600">MIHADX PRO BD</h1>
      <div class="flex gap-3">
        <button onclick="toggleTheme()" class="p-2 bg-slate-100 dark:bg-slate-700 rounded-full">🌙</button>
        <button onclick="toggleLang()" class="font-bold text-sm">EN/BN</button>
      </div>
    </header>

    <main class="p-4 pb-24 space-y-8">
      
      <!-- Topup Center -->
      <section>
        <h2 class="text-xl font-bold mb-4">টপআপ সেন্টার</h2>
        <div class="flex gap-2 mb-4">
          <button onclick="showTopup('ff')" class="flex-1 bg-orange-600 text-white py-2 rounded-lg font-bold">Free Fire</button>
          <button onclick="showTopup('ef')" class="flex-1 bg-slate-200 dark:bg-slate-700 py-2 rounded-lg font-bold">eFootball</button>
        </div>

        <div id="ff-grid" class="grid grid-cols-2 gap-3">
          <!-- Prices: Small (+5), Medium (+10), Large (+15) -->
          <div class="bg-white dark:bg-slate-800 p-3 rounded-lg shadow text-center" onclick="alert('25 Dia: 30 TK')">25 Dia - 30 TK</div>
          <div class="bg-white dark:bg-slate-800 p-3 rounded-lg shadow text-center" onclick="alert('50 Dia: 50 TK')">50 Dia - 50 TK</div>
          <div class="bg-white dark:bg-slate-800 p-3 rounded-lg shadow text-center" onclick="alert('100 Dia: 85 TK')">100 Dia - 85 TK</div>
          <div class="bg-white dark:bg-slate-800 p-3 rounded-lg shadow text-center" onclick="alert('115 Dia: 93 TK')">115 Dia - 93 TK</div>
          <div class="bg-white dark:bg-slate-800 p-3 rounded-lg shadow text-center" onclick="alert('240 Dia: 175 TK')">240 Dia - 175 TK</div>
          <div class="bg-white dark:bg-slate-800 p-3 rounded-lg shadow text-center" onclick="alert('610 Dia: 415 TK')">610 Dia - 415 TK</div>
          <div class="bg-white dark:bg-slate-800 p-3 rounded-lg shadow text-center" onclick="alert('Monthly: 790 TK')">Monthly - 790 TK</div>
          <div class="bg-white dark:bg-slate-800 p-3 rounded-lg shadow text-center" onclick="alert('10120 Dia: 6385 TK')">10120 Dia - 6385 TK</div>
        </div>

        <div id="ef-grid" class="hidden-section bg-slate-200 dark:bg-slate-800 p-6 rounded-lg text-center">
          <p class="font-bold">ই-ফুটবল (Coming Soon)</p>
        </div>
      </section>

      <!-- Ecommerce -->
      <section>
        <h2 class="text-xl font-bold mb-4">ই-কমার্স</h2>
        <div class="grid grid-cols-2 gap-3">
          <div class="bg-white dark:bg-slate-800 p-3 rounded-lg shadow text-center">শার্ট</div>
          <div class="bg-white dark:bg-slate-800 p-3 rounded-lg shadow text-center">প্যান্ট</div>
          <div class="bg-white dark:bg-slate-800 p-3 rounded-lg shadow text-center">জুতা</div>
          <div class="bg-white dark:bg-slate-800 p-3 rounded-lg shadow text-center">অন্যান্য</div>
        </div>
      </section>

      <!-- Services -->
      <section>
        <h2 class="text-xl font-bold mb-4">সেবা</h2>
        <div class="grid grid-cols-2 gap-3">
          <div class="bg-white dark:bg-slate-800 p-3 rounded-lg shadow text-center">MS Excel</div>
          <div class="bg-white dark:bg-slate-800 p-3 rounded-lg shadow text-center">Word</div>
          <div class="bg-white dark:bg-slate-800 p-3 rounded-lg shadow text-center">PowerPoint</div>
          <div class="bg-white dark:bg-slate-800 p-3 rounded-lg shadow text-center">Data Entry</div>
        </div>
      </section>
    </main>

    <!-- Bottom Nav -->
    <nav class="fixed bottom-0 left-0 w-full bg-white dark:bg-slate-900 border-t border-slate-200 p-3 flex justify-around">
      <button class="font-bold text-orange-600">Home</button>
      <button class="font-bold">Orders</button>
    </nav>
  </div>

  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
    import { getAuth, GoogleAuthProvider, signInWithRedirect, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js";
    
    // Firebase Config (Replace with yours)
    const firebaseConfig = { apiKey: "YOUR_API_KEY", projectId: "YOUR_PROJECT_ID", ... };
    const app = initializeApp(firebaseConfig);
    const auth = getAuth(app);

    // Login
    document.getElementById('btn-login').onclick = () => signInWithRedirect(auth, new GoogleAuthProvider());
    onAuthStateChanged(auth, (user) => { if (user) document.getElementById('app-content').classList.remove('hidden'); });

    // UI Helpers
    window.toggleTheme = () => document.documentElement.classList.toggle('dark');
    window.showTopup = (type) => {
      document.getElementById('ff-grid').classList.toggle('hidden-section', type !== 'ff');
      document.getElementById('ef-grid').classList.toggle('hidden-section', type !== 'ef');
    };
  </script>
</body>
</html>

